.woff) format('woff');\n}"],["STYLE",{},":root {\n  font-family: \"Open Sans\", \"Segoe UI\", Arial, sans-serif;\n  color: #17211e;\n  background: #f2f5f3;\n  font-synthesis: none;\n  text-rendering: optimizeLegibility;\n  --ink: #17211e;\n  --muted: #65736e;\n  --subtle: #87928e;\n  --canvas: #f2f5f3;\n  --surface: #ffffff;\n  --surface-soft: #f7f9f8;\n  --border: #dce3e0;\n  --border-strong: #c9d3cf;\n  --brand: #155c4d;\n  --brand-dark: #10473c;\n  --blue: #2f6d91;\n  --amber: #b7791f;\n  --red: #b13b3b;\n  --purple: #73558d;\n  --green: #4f7a55;\n  --sidebar: #17211e;\n  --sidebar-muted: #aebbb6;\n  --shadow: 0 8px 22px rgba(26, 42, 36, 0.06);\n}\n\n* {\n  box-sizing: border-box;\n  letter-spacing: 0;\n}\n\nhtml {\n  min-width: 320px;\n  min-height: 100%;\n}\n\nbody {\n  margin: 0;\n  min-width: 320px;\n  min-height: 100vh;\n  background: var(--canvas);\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\n\nbutton,\na {\n  -webkit-tap-highlight-color: transparent;\n}\n\nbutton {\n  color: inherit;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nh1,\nh2,\nh3,\np {\n  margin: 0;\n}\n\nh1 {\n  font-size: 25px;\n  line-height: 1.25;\n}\n\nh2 {\n  font-size: 16px;\n  line-height: 1.35;\n}\n\nh3 {\n  font-size: 15px;\n  line-height: 1.4;\n}\n\nsmall {\n  color: var(--muted);\n}\n\n.button {\n  min-height: 40px;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  padding: 0 15px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  font-weight: 650;\n  font-size: 14px;\n  cursor: pointer;\n  transition:\n    background 160ms ease,\n    border-color 160ms ease,\n    color 160ms ease,\n    transform 160ms ease;\n}\n\n.button:active:not(:disabled) {\n  transform: translateY(1px);\n}\n\n.button:disabled {\n  cursor: not-allowed;\n  opacity: 0.55;\n}\n\n.button-primary {\n  background: var(--brand);\n  border-color: var(--brand);\n  color: #fff;\n}\n\n.button-primary:hover:not(:disabled) {\n  background: var(--brand-dark);\n  border-color: var(--brand-dark);\n}\n\n.button-secondary {\n  background: #fff;\n  border-color: var(--border-strong);\n  color: var(--ink);\n}\n\n.button-secondary:hover:not(:disabled) {\n  border-color: var(--brand);\n  color: var(--brand);\n}\n\n.button-small {\n  min-height: 34px;\n  padding: 0 12px;\n  font-size: 13px;\n}\n\n.icon-button {\n  width: 36px;\n  height: 36px;\n  flex: 0 0 36px;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  background: transparent;\n  display: inline-grid;\n  place-items: center;\n  cursor: pointer;\n}\n\n.icon-button:hover {\n  background: rgba(21, 92, 77, 0.08);\n  color: var(--brand);\n}\n\n.spinner {\n  width: 17px;\n  height: 17px;\n  display: inline-block;\n  border: 2px solid #cbd5d1;\n  border-top-color: var(--brand);\n  border-radius: 50%;\n  animation: spin 700ms linear infinite;\n}\n\n.spinner-light {\n  border-color: rgba(255, 255, 255, 0.4);\n  border-top-color: #fff;\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n.eyebrow {\n  display: block;\n  margin-bottom: 5px;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.2;\n  font-weight: 750;\n  text-transform: uppercase;\n}\n\n.badge,\n.risk-badge,\n.incident-status,\n.active-label,\n.role-label,\n.channel-label,\n.ai-label,\n.panel-kpi {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  white-space: nowrap;\n}\n\n.badge {\n  min-height: 25px;\n  padding: 3px 8px;\n  border-radius: 5px;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.badge-new {\n  color: #2f6d91;\n  background: #e8f1f7;\n}\n\n.badge-triaged {\n  color: #73558d;\n  background: #f0eaf5;\n}\n\n.badge-in_progress {\n  color: #8a5c14;\n  background: #f8eedc;\n}\n\n.badge-waiting {\n  color: #805a45;\n  background: #f3ebe6;\n}\n\n.badge-resolved,\n.badge-closed {\n  color: #37633d;\n  background: #e9f2ea;\n}\n\n.badge-priority {\n  background: #f1f4f3;\n  color: #56625e;\n}\n\n.priority-high {\n  color: #9b6214;\n  background: #fbefdc;\n}\n\n.priority-urgent {\n  color: #a73131;\n  background: #fae8e8;\n}\n\n.priority-low {\n  color: #55706a;\n  background: #eaf0ee;\n}\n\n.risk-badge {\n  gap: 6px;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.risk-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n}\n\n.risk-high {\n  color: var(--red);\n}\n\n.risk-high .risk-dot {\n  background: var(--red);\n}\n\n.risk-medium {\n  color: var(--amber);\n}\n\n.risk-medium .risk-dot {\n  background: var(--amber);\n}\n\n.risk-low {\n  color: var(--green);\n}\n\n.risk-low .risk-dot {\n  background: var(--green);\n}\n\n.avatar {\n  display: inline-grid;\n  place-items: center;\n  flex: 0 0 auto;\n  color: #fff;\n  border-radius: 50%;\n  font-weight: 750;\n}\n\n.avatar-small {\n  width: 32px;\n  height: 32px;\n  font-size: 11px;\n}\n\n.avatar-medium {\n  width: 40px;\n  height: 40px;\n  font-size: 13px;\n}\n\n.avatar-large {\n  width: 52px;\n  height: 52px;\n  font-size: 16px;\n}\n\n.state-panel {\n  min-height: 108px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.state-error {\n  min-height: 58px;\n  padding: 14px 18px;\n  justify-content: flex-start;\n  color: #8f3030;\n  background: #fff9f9;\n  border-color: #efcdcd;\n}\n\n.state-error .button {\n  margin-left: auto;\n}\n\n.empty-state {\n  min-height: 220px;\n  padding: 32px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: var(--muted);\n  text-align: center;\n}\n\n.empty-state strong {\n  color: var(--ink);\n}\n\n.inline-empty {\n  padding: 24px;\n  color: var(--muted);\n  text-align: center;\n  font-size: 13px;\n}\n\n.form-error {\n  border: 1px solid #efcdcd;\n  border-radius: 6px;\n  padding: 10px 12px;\n  color: #923737;\n  background: #fff7f7;\n  font-size: 13px;\n}\n\n.login-screen {\n  min-height: 100vh;\n  padding: 34px;\n  background: #17211e;\n  display: grid;\n  grid-template-rows: auto 1fr auto;\n  place-items: center;\n  color: #fff;\n}\n\n.login-brand {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  justify-self: start;\n}\n\n.login-brand > div,\n.brand > div {\n  display: flex;\n  flex-direction: column;\n}\n\n.login-brand strong {\n  font-size: 18px;\n}\n\n.login-brand span {\n  color: #aebbb6;\n  font-size: 11px;\n}\n\n.brand-mark {\n  width: 36px;\n  height: 36px;\n  display: inline-grid;\n  place-items: center;\n  border-radius: 6px;\n  color: #fff;\n  background: var(--brand);\n}\n\n.brand-mark-light {\n  background: #f4f7f5;\n  color: var(--brand);\n}\n\n.login-panel {\n  width: min(420px, 100%);\n  padding: 30px;\n  border: 1px solid #dce3e0;\n  border-radius: 8px;\n  background: #fff;\n  color: var(--ink);\n  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);\n}\n\n.login-heading h1 {\n  margin-bottom: 7px;\n  font-size: 28px;\n}\n\n.login-heading p {\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.demo-switcher {\n  margin: 24px 0;\n  padding: 4px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  background: var(--surface-soft);\n}\n\n.demo-switcher button {\n  height: 34px;\n  border: 0;\n  border-radius: 5px;\n  background: transparent;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n  cursor: pointer;\n}\n\n.demo-switcher button.active {\n  background: #fff;\n  color: var(--brand);\n  box-shadow: 0 1px 4px rgba(23, 33, 30, 0.1);\n}\n\n.form-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.field {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n\n.field > span:first-child,\n.field > label:first-child,\n.action-bar label > span {\n  color: #4e5b57;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.field input,\n.field textarea,\n.field select,\n.action-bar select {\n  width: 100%;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: #fff;\n  color: var(--ink);\n  outline: 0;\n}\n\n.field input,\n.field select,\n.action-bar select {\n  height: 42px;\n  padding: 0 12px;\n}\n\n.field textarea {\n  min-height: 112px;\n  resize: vertical;\n  padding: 11px 12px;\n  line-height: 1.5;\n}\n\n.field input:focus,\n.field textarea:focus,\n.field select:focus,\n.action-bar select:focus {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px rgba(21, 92, 77, 0.1);\n}\n\n.field small {\n  align-self: flex-end;\n  font-size: 11px;\n}\n\n.password-field {\n  height: 42px;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  background: #fff;\n}\n\n.password-field:focus-within {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px rgba(21, 92, 77, 0.1);\n}\n\n.password-field input {\n  border: 0;\n  height: 40px;\n  box-shadow: none;\n}\n\n.password-field input:focus {\n  box-shadow: none;\n}\n\n.password-field .icon-button {\n  margin-right: 2px;\n}\n\n.login-button {\n  width: 100%;\n  margin-top: 4px;\n}\n\n.login-button svg:last-child {\n  margin-left: auto;\n}\n\n.login-footer {\n  color: #91a09b;\n  font-size: 11px;\n}\n\n.boot-screen {\n  min-height: 100vh;\n  display: grid;\n  place-items: center;\n}\n\n.boot-screen .state-panel {\n  width: min(420px, calc(100% - 32px));\n}\n\n.app-frame {\n  min-height: 100vh;\n}\n\n.sidebar {\n  position: fixed;\n  z-index: 30;\n  inset: 0 auto 0 0;\n  width: 244px;\n  padding: 18px 13px;\n  display: flex;\n  flex-direction: column;\n  color: #f5f8f6;\n  background: var(--sidebar);\n}\n\n.brand {\n  height: 48px;\n  padding: 0 8px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.brand strong {\n  font-size: 16px;\n}\n\n.brand span {\n  color: var(--sidebar-muted);\n  font-size: 10px;\n}\n\n.sidebar-close {\n  display: none;\n  margin-left: auto;\n  color: #fff;\n}\n\n.main-nav {\n  margin-top: 26px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.nav-section-label {\n  margin: 0 10px 8px;\n  color: #81908b;\n  font-size: 10px;\n  font-weight: 750;\n  text-transform: uppercase;\n}\n\n.nav-item {\n  min-height: 42px;\n  padding: 0 11px;\n  border: 0;\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  color: #bac5c1;\n  background: transparent;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.nav-item:hover {\n  color: #fff;\n  background: rgba(255, 255, 255, 0.06);\n}\n\n.nav-item.active {\n  color: #fff;\n  background: #285348;\n}\n\n.sidebar-footer {\n  margin-top: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n}\n\n.organization-switcher {\n  width: 100%;\n  min-height: 56px;\n  padding: 8px;\n  border: 1px solid #35433f;\n  border-radius: 7px;\n  display: grid;\n  grid-template-columns: 34px 1fr 16px;\n  align-items: center;\n  gap: 9px;\n  color: #fff;\n  background: #1d2a26;\n  text-align: left;\n  cursor: pointer;\n}\n\n.organization-summary {\n  grid-template-columns: 34px minmax(0, 1fr);\n  cursor: default;\n}\n\n.organization-logo {\n  width: 34px;\n  height: 34px;\n  display: grid;\n  place-items: center;\n  border-radius: 5px;\n  background: #f2efe6;\n  color: #6d4e28;\n  font-size: 11px;\n  font-weight: 800;\n}\n\n.organization-switcher > span:nth-child(2) {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.organization-switcher strong {\n  overflow: hidden;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.organization-switcher small {\n  color: #91a09b;\n  font-size: 10px;\n}\n\n.logout-button {\n  width: 100%;\n}\n\n.app-main {\n  min-height: 100vh;\n  margin-left: 244px;\n}\n\n.topbar {\n  position: sticky;\n  z-index: 20;\n  top: 0;\n  height: 68px;\n  padding: 0 26px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  background: rgba(255, 255, 255, 0.96);\n}\n\n.topbar-title {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.topbar-title > div {\n  display: flex;\n  flex-direction: column;\n}\n\n.topbar-title strong {\n  font-size: 14px;\n}\n\n.topbar-title span {\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.mobile-menu {\n  display: none;\n}\n\n.topbar-actions {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.notification-button {\n  position: relative;\n  border-color: var(--border);\n}\n\n.notification-dot {\n  position: absolute;\n  top: 7px;\n  right: 7px;\n  width: 6px;\n  height: 6px;\n  border: 1px solid #fff;\n  border-radius: 50%;\n  background: var(--red);\n}\n\n.user-summary {\n  min-width: 170px;\n  padding-left: 13px;\n  border-left: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.user-summary > span {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.user-summary strong {\n  max-width: 150px;\n  overflow: hidden;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.user-summary small {\n  max-width: 150px;\n  overflow: hidden;\n  font-size: 10px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.content {\n  width: min(1440px, 100%);\n  margin: 0 auto;\n  padding: 26px;\n}\n\n.page-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.page-header,\n.overview-intro,\n.detail-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.page-header p,\n.overview-intro p,\n.detail-header p {\n  margin-top: 6px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.page-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.overview-intro {\n  min-height: 58px;\n  align-items: center;\n}\n\n.overview-intro h1 {\n  font-size: 22px;\n}\n\n.metric-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.metric-card {\n  min-height: 118px;\n  padding: 18px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  display: flex;\n  align-items: flex-start;\n  gap: 13px;\n  background: var(--surface);\n}\n\n.metric-icon {\n  width: 38px;\n  height: 38px;\n  flex: 0 0 38px;\n  border-radius: 6px;\n  display: grid;\n  place-items: center;\n}\n\n.metric-blue {\n  color: var(--blue);\n  background: #e8f1f7;\n}\n\n.metric-amber {\n  color: var(--amber);\n  background: #f8eedc;\n}\n\n.metric-green {\n  color: var(--green);\n  background: #e9f2ea;\n}\n\n.metric-red {\n  color: var(--red);\n  background: #fae8e8;\n}\n\n.metric-card > div {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  grid-template-rows: auto auto;\n  column-gap: 10px;\n  flex: 1;\n}\n\n.metric-card > div > span {\n  grid-column: 1 / -1;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.metric-card strong {\n  margin-top: 7px;\n  font-size: 29px;\n  line-height: 1;\n}\n\n.metric-card small {\n  align-self: end;\n  font-size: 10px;\n}\n\n.panel {\n  min-width: 0;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface);\n}\n\n.panel-heading {\n  min-height: 68px;\n  padding: 15px 18px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.panel-heading h2 {\n  font-size: 15px;\n}\n\n.panel-kpi {\n  min-height: 27px;\n  padding: 3px 8px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  gap: 6px;\n  color: var(--muted);\n  background: var(--surface-soft);\n  font-size: 11px;\n  font-weight: 650;\n}\n\n.muted-icon {\n  color: var(--subtle);\n}\n\n.dashboard-grid {\n  display: grid;\n  gap: 14px;\n}\n\n.dashboard-grid-main {\n  grid-template-columns: minmax(0, 1.6fr) minmax(310px, 0.9fr);\n}\n\n.dashboard-grid-lists {\n  grid-template-columns: minmax(0, 1.35fr) minmax(320px, 0.8fr);\n}\n\n.chart-wrap {\n  height: 265px;\n  padding: 18px 12px 8px;\n}\n\n.donut-layout {\n  min-height: 265px;\n  padding: 15px;\n  display: grid;\n  grid-template-columns: minmax(160px, 1fr) minmax(130px, 0.8fr);\n  align-items: center;\n}\n\n.donut-chart {\n  height: 205px;\n}\n\n.chart-legend {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.chart-legend > div {\n  display: grid;\n  grid-template-columns: 8px 1fr auto;\n  align-items: center;\n  gap: 7px;\n}\n\n.chart-legend > div > span {\n  width: 8px;\n  height: 8px;\n  border-radius: 2px;\n}\n\n.chart-legend small {\n  overflow: hidden;\n  font-size: 10px;\n  text-transform: capitalize;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.chart-legend strong {\n  font-size: 11px;\n}\n\n.text-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--brand);\n  font-size: 12px;\n  font-weight: 700;\n}\n\n.text-link:hover {\n  text-decoration: underline;\n}\n\n.risk-list,\n.incident-list {\n  display: flex;\n  flex-direction: column;\n}\n\n.risk-row {\n  min-height: 65px;\n  padding: 10px 18px;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 95px 1fr auto;\n  align-items: center;\n  gap: 12px;\n}\n\n.risk-row:last-child,\n.incident-row:last-child {\n  border-bottom: 0;\n}\n\n.risk-row:hover,\n.incident-row:hover {\n  background: var(--surface-soft);\n}\n\n.case-code {\n  color: var(--blue);\n  font-size: 10px;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.risk-row-main {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.risk-row-main strong {\n  overflow: hidden;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.risk-row-main small {\n  overflow: hidden;\n  font-size: 10px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.ai-label {\n  min-height: 25px;\n  padding: 3px 7px;\n  border: 1px solid #d6c9e0;\n  border-radius: 5px;\n  gap: 5px;\n  color: #674b7e;\n  background: #f3edf7;\n  font-size: 10px;\n  font-weight: 800;\n}\n\n.incident-row {\n  min-height: 72px;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 8px 1fr 18px;\n  align-items: center;\n  gap: 10px;\n}\n\n.incident-row > span:nth-child(2) {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.incident-row strong {\n  overflow: hidden;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.incident-row small {\n  font-size: 10px;\n}\n\n.severity-marker {\n  width: 5px;\n  height: 34px;\n  border-radius: 3px;\n}\n\n.severity-critical {\n  color: #a72f2f;\n  background: #f7dddd;\n}\n\n.severity-high {\n  color: #a72f2f;\n  background: #e25e5e;\n}\n\n.severity-medium {\n  color: #8a5c14;\n  background: #d89b42;\n}\n\n.severity-low {\n  color: #356a62;\n  background: #67a89c;\n}\n\n.table-scroll {\n  overflow-x: auto;\n}\n\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12px;\n}\n\n.data-table th,\n.data-table td {\n  height: 58px;\n  padding: 9px 16px;\n  border-bottom: 1px solid var(--border);\n  text-align: left;\n  vertical-align: middle;\n}\n\n.data-table th {\n  height: 42px;\n  color: var(--muted);\n  background: var(--surface-soft);\n  font-size: 10px;\n  font-weight: 750;\n  text-transform: uppercase;\n}\n\n.data-table tbody tr:last-child td {\n  border-bottom: 0;\n}\n\n.data-table tbody tr:hover {\n  background: #fafcfb;\n}\n\n.data-table td > small,\n.data-table td > .table-title {\n  display: block;\n}\n\n.table-title {\n  margin-bottom: 3px;\n  font-size: 12px;\n}\n\n.case-link {\n  color: var(--blue);\n  font-weight: 750;\n}\n\n.page-header {\n  align-items: center;\n}\n\n.filter-panel {\n  padding: 0;\n}\n\n.status-tabs {\n  min-height: 50px;\n  padding: 0 14px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  gap: 4px;\n  overflow-x: auto;\n}\n\n.status-tabs button {\n  min-width: max-content;\n  height: 50px;\n  padding: 0 10px;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  color: var(--muted);\n  background: transparent;\n  font-size: 12px;\n  font-weight: 650;\n  cursor: pointer;\n}\n\n.status-tabs button.active {\n  border-bottom-color: var(--brand);\n  color: var(--brand);\n}\n\n.filter-row {\n  padding: 12px 14px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.search-box {\n  width: min(420px, 100%);\n  height: 38px;\n  padding: 0 10px;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--muted);\n  background: #fff;\n}\n\n.search-box:focus-within {\n  border-color: var(--brand);\n}\n\n.search-box input {\n  min-width: 0;\n  flex: 1;\n  border: 0;\n  outline: 0;\n  font-size: 12px;\n}\n\n.compact-select {\n  height: 38px;\n  margin-left: auto;\n  padding: 0 8px;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  background: #fff;\n}\n\n.compact-select select {\n  border: 0;\n  outline: 0;\n  color: var(--ink);\n  background: transparent;\n  font-size: 12px;\n}\n\n.table-summary {\n  min-height: 48px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.table-summary strong {\n  font-size: 12px;\n}\n\n.table-summary span {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.cases-table {\n  min-width: 1060px;\n}\n\n.case-title-cell {\n  max-width: 310px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.case-title-cell span {\n  color: var(--blue);\n  font-size: 10px;\n  font-weight: 800;\n}\n\n.case-title-cell strong {\n  overflow: hidden;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.overdue-text {\n  color: var(--red);\n  font-weight: 700;\n}\n\n.intake-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1.45fr) minmax(310px, 0.7fr);\n  align-items: start;\n  gap: 16px;\n}\n\n.intake-form {\n  padding: 22px;\n}\n\n.section-heading {\n  margin-bottom: 24px;\n  display: flex;\n  align-items: flex-start;\n  gap: 11px;\n}\n\n.step-index {\n  width: 31px;\n  height: 31px;\n  display: grid;\n  place-items: center;\n  border-radius: 6px;\n  color: var(--brand);\n  background: #e7f0ed;\n  font-size: 10px;\n  font-weight: 800;\n}\n\n.section-heading h2 {\n  margin-bottom: 3px;\n}\n\n.section-heading p {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 17px;\n}\n\n.field-wide {\n  grid-column: 1 / -1;\n}\n\n.form-actions {\n  margin-top: 22px;\n  padding-top: 18px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 9px;\n}\n\n.ai-preview {\n  position: sticky;\n  top: 88px;\n}\n\n.analysis-content {\n  padding: 18px;\n}\n\n.confidence-block {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.confidence-block > div {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.confidence-block span {\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.confidence-block strong {\n  font-size: 13px;\n}\n\n.confidence-block > span {\n  color: var(--brand);\n  font-size: 18px;\n  font-weight: 800;\n}\n\n.confidence-track {\n  height: 5px;\n  margin: 10px 0 18px;\n  border-radius: 3px;\n  overflow: hidden;\n  background: #e8eeeb;\n}\n\n.confidence-track span {\n  display: block;\n  height: 100%;\n  border-radius: 3px;\n  background: var(--brand);\n}\n\n.analysis-item {\n  min-height: 54px;\n  padding: 10px 0;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n}\n\n.analysis-item > svg {\n  margin-top: 2px;\n  color: var(--brand);\n}\n\n.analysis-item > div {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.analysis-item strong {\n  font-size: 11px;\n}\n\n.analysis-item span {\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.similar-list {\n  margin-top: 4px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  overflow: hidden;\n}\n\n.similar-list > div {\n  min-height: 40px;\n  padding: 7px 9px;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 34px 1fr;\n  align-items: center;\n  gap: 7px;\n}\n\n.similar-list > div:last-child {\n  border-bottom: 0;\n}\n\n.similar-list span {\n  color: var(--purple);\n  font-size: 10px;\n  font-weight: 800;\n}\n\n.similar-list strong {\n  overflow: hidden;\n  font-size: 10px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.model-note {\n  margin-top: 13px;\n  color: var(--subtle);\n  font-size: 9px;\n}\n\n.ai-placeholder {\n  min-height: 330px;\n  padding: 30px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  color: var(--muted);\n  text-align: center;\n}\n\n.ai-placeholder svg {\n  margin-bottom: 5px;\n  color: var(--purple);\n}\n\n.ai-placeholder strong {\n  color: var(--ink);\n  font-size: 13px;\n}\n\n.ai-placeholder span {\n  max-width: 220px;\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.back-link {\n  margin-bottom: 11px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.back-link:hover {\n  color: var(--brand);\n}\n\n.detail-title-row {\n  margin-bottom: 7px;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.detail-header h1 {\n  max-width: 780px;\n  font-size: 24px;\n}\n\n.detail-header-actions {\n  padding-top: 30px;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n}\n\n.action-bar {\n  min-height: 66px;\n  padding: 10px 14px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #fff;\n}\n\n.action-bar label {\n  min-width: 190px;\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.action-bar select {\n  height: 32px;\n  padding: 0 8px;\n  font-size: 11px;\n}\n\n.action-spacer {\n  flex: 1;\n}\n\n.saving-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.case-detail-grid {\n  display: grid;\n  grid-template-columns: minmax(0, 1.5fr) minmax(310px, 0.65fr);\n  align-items: start;\n  gap: 16px;\n}\n\n.case-main-column,\n.case-side-column {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.case-description > p {\n  padding: 20px;\n  color: #35413d;\n  font-size: 13px;\n  line-height: 1.7;\n  white-space: pre-wrap;\n}\n\n.channel-label {\n  min-height: 24px;\n  padding: 3px 7px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  color: var(--muted);\n  background: var(--surface-soft);\n  font-size: 10px;\n  text-transform: capitalize;\n}\n\n.comment-list {\n  max-height: 420px;\n  overflow-y: auto;\n}\n\n.comment {\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--border);\n}\n\n.comment > div {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.comment strong {\n  font-size: 11px;\n}\n\n.comment > div > span {\n  padding: 2px 5px;\n  border-radius: 4px;\n  color: #765619;\n  background: #f8eedc;\n  font-size: 9px;\n  font-weight: 700;\n}\n\n.comment time {\n  margin-left: auto;\n  color: var(--subtle);\n  font-size: 9px;\n}\n\n.comment p {\n  margin-top: 7px;\n  color: #3d4945;\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.comment-internal {\n  background: #fffaf1;\n}\n\n.comment-form {\n  padding: 14px 18px;\n}\n\n.comment-form textarea {\n  width: 100%;\n  resize: vertical;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  padding: 10px;\n  outline: 0;\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.comment-form textarea:focus {\n  border-color: var(--brand);\n}\n\n.comment-form > div {\n  margin-top: 8px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.checkbox-field {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.checkbox-field input {\n  width: 15px;\n  height: 15px;\n  accent-color: var(--brand);\n}\n\n.timeline {\n  margin: 0;\n  padding: 10px 18px 16px;\n  list-style: none;\n}\n\n.timeline li {\n  position: relative;\n  min-height: 58px;\n  padding: 10px 0 10px 36px;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  align-items: start;\n  gap: 10px;\n}\n\n.timeline li:not(:last-child)::before {\n  content: \"\";\n  position: absolute;\n  top: 32px;\n  bottom: -10px;\n  left: 11px;\n  width: 1px;\n  background: var(--border);\n}\n\n.timeline-marker {\n  position: absolute;\n  top: 10px;\n  left: 0;\n  width: 23px;\n  height: 23px;\n  border: 1px solid var(--border-strong);\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  color: var(--brand);\n  background: #fff;\n}\n\n.timeline-marker > span {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--brand);\n}\n\n.timeline li > div {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.timeline strong {\n  font-size: 11px;\n}\n\n.timeline li > div > span,\n.timeline time {\n  color: var(--muted);\n  font-size: 9px;\n}\n\n.ai-insight-panel {\n  border-top: 3px solid var(--purple);\n}\n\n.risk-score-block {\n  padding: 18px;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n}\n\n.risk-ring {\n  --risk: 0deg;\n  width: 64px;\n  height: 64px;\n  flex: 0 0 64px;\n  border-radius: 50%;\n  display: grid;\n  place-items: center;\n  background: conic-gradient(var(--red) var(--risk), #e8eeeb 0);\n}\n\n.risk-ring::before {\n  content: \"\";\n  grid-area: 1 / 1;\n  width: 50px;\n  height: 50px;\n  border-radius: 50%;\n  background: #fff;\n}\n\n.risk-ring span {\n  z-index: 1;\n  grid-area: 1 / 1;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.risk-score-block > div:last-child {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.risk-score-block strong {\n  font-size: 12px;\n}\n\n.risk-score-block span {\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.ai-summary {\n  margin: 0 18px;\n  padding: 12px;\n  border: 1px solid #dfd3e6;\n  border-radius: 6px;\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n  color: #4f3e5e;\n  background: #f8f4fa;\n}\n\n.ai-summary svg {\n  flex: 0 0 auto;\n}\n\n.ai-summary p {\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.factor-list {\n  padding: 16px 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.factor-list > strong {\n  margin-bottom: 2px;\n  font-size: 10px;\n  text-transform: uppercase;\n}\n\n.factor-list > div {\n  display: grid;\n  grid-template-columns: 7px 1fr;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.4;\n}\n\n.factor-list > div > span {\n  width: 6px;\n  height: 6px;\n  margin-top: 4px;\n  border-radius: 50%;\n  background: var(--amber);\n}\n\n.confidence-row {\n  min-height: 44px;\n  padding: 0 18px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  font-size: 10px;\n}\n\n.confidence-row span {\n  color: var(--muted);\n}\n\n.case-metadata dl {\n  margin: 0;\n}\n\n.case-metadata dl > div {\n  min-height: 54px;\n  padding: 10px 18px;\n  border-bottom: 1px solid var(--border);\n}\n\n.case-metadata dl > div:last-child {\n  border-bottom: 0;\n}\n\n.case-metadata dt {\n  margin-bottom: 4px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  font-size: 10px;\n}\n\n.case-metadata dd {\n  margin: 0;\n  font-size: 11px;\n  font-weight: 650;\n}\n\n.incident-grid,\n.service-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.incident-card,\n.service-card {\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: #fff;\n}\n\n.incident-card > header,\n.service-card > header {\n  min-height: 76px;\n  padding: 15px 17px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: flex-start;\n  gap: 11px;\n}\n\n.incident-icon,\n.service-icon,\n.article-icon {\n  width: 36px;\n  height: 36px;\n  flex: 0 0 36px;\n  border-radius: 6px;\n  display: grid;\n  place-items: center;\n}\n\n.service-icon,\n.article-icon {\n  color: var(--blue);\n  background: #e8f1f7;\n}\n\n.incident-card header > div,\n.service-card header > div {\n  min-width: 0;\n  flex: 1;\n}\n\n.incident-card h2,\n.service-card h2 {\n  margin-top: 4px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.incident-status {\n  min-height: 23px;\n  padding: 3px 6px;\n  border-radius: 5px;\n  gap: 4px;\n  color: #8d5f17;\n  background: #f8eedc;\n  font-size: 9px;\n  font-weight: 750;\n  text-transform: capitalize;\n}\n\n.incident-card > p,\n.service-card > p {\n  min-height: 68px;\n  padding: 14px 17px;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n.incident-metrics {\n  margin: 0 17px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n}\n\n.incident-metrics > div {\n  min-height: 64px;\n  padding: 10px;\n  border-right: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--muted);\n}\n\n.incident-metrics > div:last-child {\n  border-right: 0;\n}\n\n.incident-metrics span {\n  display: flex;\n  flex-direction: column;\n  font-size: 9px;\n}\n\n.incident-metrics strong {\n  color: var(--ink);\n  font-size: 14px;\n}\n\n.keyword-row {\n  min-height: 48px;\n  padding: 10px 17px;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.keyword-row span,\n.service-card footer span {\n  padding: 3px 7px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  color: var(--muted);\n  background: var(--surface-soft);\n  font-size: 9px;\n}\n\n.incident-card > footer {\n  min-height: 48px;\n  padding: 10px 17px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.incident-card > footer > span {\n  color: var(--muted);\n  font-size: 9px;\n}\n\n.knowledge-search {\n  padding: 24px;\n  border: 1px solid #cfd9d5;\n  border-radius: 7px;\n  background: #edf4f1;\n}\n\n.knowledge-search-heading {\n  margin-bottom: 14px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.knowledge-search-heading h2 {\n  font-size: 17px;\n}\n\n.knowledge-search > form {\n  min-height: 50px;\n  padding: 5px 6px 5px 14px;\n  border: 1px solid var(--border-strong);\n  border-radius: 7px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--muted);\n  background: #fff;\n}\n\n.knowledge-search > form:focus-within {\n  border-color: var(--brand);\n}\n\n.knowledge-search > form input {\n  min-width: 0;\n  flex: 1;\n  border: 0;\n  outline: 0;\n}\n\n.knowledge-answer {\n  margin-top: 16px;\n}\n\n.knowledge-answer > p {\n  margin-bottom: 12px;\n  color: #40514b;\n  font-size: 12px;\n}\n\n.citation-list {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 9px;\n}\n\n.citation-list article {\n  padding: 13px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: #fff;\n}\n\n.citation-list header {\n  display: grid;\n  grid-template-columns: 18px 1fr auto;\n  gap: 7px;\n  align-items: center;\n}\n\n.citation-list header svg {\n  color: var(--blue);\n}\n\n.citation-list header strong {\n  overflow: hidden;\n  font-size: 11px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.citation-list header span {\n  color: var(--brand);\n  font-size: 9px;\n  font-weight: 800;\n}\n\n.citation-list article p {\n  margin: 9px 0;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n.citation-list footer {\n  color: var(--subtle);\n  font-size: 9px;\n}\n\n.article-list > article {\n  min-height: 116px;\n  padding: 16px 18px;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 36px 1fr 36px;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.article-list > article:last-child {\n  border-bottom: 0;\n}\n\n.article-category {\n  color: var(--blue);\n  font-size: 9px;\n  font-weight: 750;\n  text-transform: uppercase;\n}\n\n.article-list h3 {\n  margin: 4px 0;\n}\n\n.article-list p {\n  display: -webkit-box;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.5;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 2;\n}\n\n.article-list footer {\n  margin-top: 8px;\n  display: flex;\n  gap: 12px;\n  color: var(--subtle);\n  font-size: 9px;\n}\n\n.active-label {\n  min-height: 23px;\n  padding: 3px 7px;\n  border-radius: 5px;\n  color: #37633d;\n  background: #e9f2ea;\n  font-size: 9px;\n  font-weight: 750;\n}\n\n.service-card dl {\n  margin: 0 17px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  display: grid;\n  grid-template-columns: 1fr 0.7fr;\n}\n\n.service-card dl > div {\n  min-height: 58px;\n  padding: 10px;\n  border-right: 1px solid var(--border);\n}\n\n.service-card dl > div:last-child {\n  border-right: 0;\n}\n\n.service-card dt {\n  margin-bottom: 5px;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--muted);\n  font-size: 9px;\n}\n\n.service-card dd {\n  margin: 0;\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.service-card footer {\n  min-height: 48px;\n  padding: 10px 17px;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.users-table {\n  min-width: 820px;\n}\n\n.member-cell {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n\n.member-cell > span {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.member-cell strong {\n  font-size: 11px;\n}\n\n.member-cell small {\n  font-size: 9px;\n}\n\n.role-label {\n  gap: 5px;\n  color: #4e5b57;\n  font-size: 10px;\n  font-weight: 650;\n}\n\n.sidebar-scrim {\n  display: none;\n}\n\n@media (max-width: 1180px) {\n  .metric-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .dashboard-grid-main,\n  .dashboard-grid-lists {\n    grid-template-columns: 1fr;\n  }\n\n  .case-detail-grid,\n  .intake-layout {\n    grid-template-columns: minmax(0, 1fr) minmax(290px, 0.65fr);\n  }\n\n  .incident-grid,\n  .service-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 900px) {\n  .sidebar {\n    transform: translateX(-100%);\n    transition: transform 180ms ease;\n  }\n\n  .sidebar-open {\n    transform: translateX(0);\n  }\n\n  .sidebar-close {\n    display: inline-grid;\n  }\n\n  .sidebar-scrim {\n    position: fixed;\n    z-index: 25;\n    inset: 0;\n    border: 0;\n    display: block;\n    background: rgba(12, 19, 17, 0.48);\n  }\n\n  .app-main {\n    margin-left: 0;\n  }\n\n  .mobile-menu {\n    display: inline-grid;\n  }\n\n  .case-detail-grid,\n  .intake-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .ai-preview {\n    position: static;\n  }\n\n  .citation-list {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 680px) {\n  .login-screen {\n    padding: 20px;\n  }\n\n  .login-panel {\n    padding: 22px;\n  }\n\n  .topbar {\n    height: 62px;\n    padding: 0 14px;\n  }\n\n  .topbar-title span,\n  .user-summary > span {\n    display: none;\n  }\n\n  .user-summary {\n    min-width: auto;\n    padding-left: 10px;\n  }\n\n  .content {\n    padding: 18px 14px 28px;\n  }\n\n  .page-header,\n  .overview-intro,\n  .detail-header {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .page-header .button,\n  .overview-intro .button {\n    width: 100%;\n  }\n\n  .metric-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .metric-card {\n    min-height: 100px;\n  }\n\n  .donut-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .donut-chart {\n    height: 180px;\n  }\n\n  .risk-row {\n    grid-template-columns: 1fr auto;\n  }\n\n  .risk-row > .case-code {\n    grid-column: 1 / -1;\n  }\n\n  .filter-row {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .search-box,\n  .compact-select {\n    width: 100%;\n    margin-left: 0;\n  }\n\n  .compact-select select {\n    flex: 1;\n  }\n\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .field-wide {\n    grid-column: auto;\n  }\n\n  .form-actions {\n    flex-direction: column-reverse;\n  }\n\n  .form-actions .button {\n    width: 100%;\n  }\n\n  .detail-header-actions {\n    padding-top: 0;\n  }\n\n  .action-bar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .action-bar label {\n    width: 100%;\n  }\n\n  .incident-metrics {\n    grid-template-columns: 1fr;\n  }\n\n  .incident-metrics > div {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .incident-metrics > div:last-child {\n    border-bottom: 0;\n  }\n\n  .incident-card > footer {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .knowledge-search {\n    padding: 16px;\n  }\n\n  .knowledge-search > form {\n    padding: 10px;\n    flex-wrap: wrap;\n  }\n\n  .knowledge-search > form input {\n    min-width: calc(100% - 34px);\n  }\n\n  .knowledge-search > form .button {\n    width: 100%;\n  }\n\n  .article-list > article {\n    grid-template-columns: 36px 1fr;\n  }\n\n  .article-list > article > .icon-button {\n    display: none;\n  }\n\n  .service-card dl {\n    grid-template-columns: 1fr;\n  }\n\n  .service-card dl > div {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .service-card dl > div:last-child {\n    border-bottom: 0;\n  }\n}\n\n/* CaseFlow 2026 design system */\n:root {\n  color: #111a17;\n  background: #f6f8f7;\n  --ink: #111a17;\n  --muted: #4b5954;\n  --subtle: #697771;\n  --canvas: #f6f8f7;\n  --surface: #ffffff;\n  --surface-soft: #fbfcfb;\n  --surface-muted: #edf1ef;\n  --border: #dce3e0;\n  --border-strong: #c7d1cd;\n  --brand: #146b57;\n  --brand-dark: #0f5545;\n  --brand-text: #115646;\n  --brand-subtle: #ecf7f3;\n  --selected: #d6eee6;\n  --info: #1f506f;\n  --info-bg: #edf6fc;\n  --info-border: #80badf;\n  --warning: #80510d;\n  --warning-bg: #fff8e8;\n  --warning-border: #ecae33;\n  --danger: #8a302a;\n  --danger-bg: #fff1f0;\n  --danger-border: #eb7770;\n  --success: #285e31;\n  --success-bg: #eef8ef;\n  --success-border: #70c17b;\n  --ai: #624075;\n  --ai-bg: #f8f1fc;\n  --ai-border: #c790e3;\n  --blue: #2f6d91;\n  --amber: #b7791f;\n  --red: #b13b3b;\n  --purple: #73558d;\n  --green: #4f7a55;\n  --sidebar: #ffffff;\n  --sidebar-muted: #697771;\n  --shadow: 0 8px 24px rgba(17, 26, 23, 0.06);\n}\n\nbody {\n  color: var(--ink);\n  background: var(--canvas);\n}\n\nh1 {\n  font-size: 26px;\n  line-height: 34px;\n  font-weight: 650;\n}\n\nh2 {\n  font-size: 18px;\n  line-height: 24px;\n  font-weight: 650;\n}\n\nh3 {\n  font-size: 14px;\n  line-height: 20px;\n  font-weight: 650;\n}\n\n.button {\n  min-height: 40px;\n  border-radius: 6px;\n  padding: 0 16px;\n  font-size: 13px;\n  font-weight: 650;\n  box-shadow: none;\n}\n\n.button-secondary {\n  border-color: var(--border);\n}\n\n.button-small {\n  min-height: 32px;\n  padding-inline: 12px;\n  font-size: 12px;\n}\n\n.icon-button {\n  width: 40px;\n  height: 40px;\n  flex-basis: 40px;\n  border-radius: 6px;\n}\n\n.eyebrow {\n  margin-bottom: 6px;\n  color: var(--subtle);\n  font-size: 10px;\n  line-height: 14px;\n  font-weight: 700;\n  letter-spacing: 0;\n}\n\n.panel {\n  border-color: var(--border);\n  border-radius: 8px;\n  box-shadow: none;\n}\n\n.panel-heading {\n  min-height: 64px;\n}\n\n.panel-heading h2 {\n  font-size: 18px;\n}\n\n.badge {\n  position: relative;\n  min-height: 24px;\n  border: 1px solid transparent;\n  border-radius: 6px;\n  padding: 3px 8px;\n  gap: 6px;\n  font-size: 11px;\n  line-height: 15px;\n}\n\n.badge-status {\n  border-radius: 999px;\n}\n\n.badge-status::before {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: currentColor;\n  content: \"\";\n}\n\n.badge-new {\n  color: var(--muted);\n  border-color: var(--border-strong);\n  background: var(--surface-muted);\n}\n\n.badge-triaged,\n.badge-in_progress {\n  color: var(--info);\n  border-color: var(--info-border);\n  background: var(--info-bg);\n}\n\n.badge-waiting {\n  color: var(--warning);\n  border-color: var(--warning-border);\n  background: var(--warning-bg);\n}\n\n.badge-resolved {\n  color: var(--success);\n  border-color: var(--success-border);\n  background: var(--success-bg);\n}\n\n.badge-closed {\n  color: var(--muted);\n  border-color: var(--border);\n  background: var(--surface-muted);\n}\n\n.badge-priority {\n  border-color: var(--info-border);\n  color: var(--info);\n  background: var(--info-bg);\n}\n\n.badge-priority::before {\n  width: 3px;\n  height: 12px;\n  border-radius: 2px;\n  background: currentColor;\n  content: \"\";\n}\n\n.priority-high {\n  color: var(--warning);\n  border-color: var(--warning-border);\n  background: var(--warning-bg);\n}\n\n.priority-urgent {\n  color: var(--danger);\n  border-color: var(--danger-border);\n  background: var(--danger-bg);\n}\n\n.priority-low {\n  color: var(--muted);\n  border-color: var(--border);\n  background: var(--surface-muted);\n}\n\n.avatar {\n  position: relative;\n  color: var(--brand-text);\n  background: var(--brand-subtle) !important;\n}\n\n.avatar::after {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  width: 8px;\n  height: 8px;\n  border: 1px solid #fff;\n  border-radius: 50%;\n  background: #76c889;\n  content: \"\";\n}\n\n.text-link {\n  border: 0;\n  padding: 0;\n  color: var(--brand-text);\n  background: transparent;\n  font-size: 12px;\n  font-weight: 650;\n  cursor: pointer;\n}\n\n/* Authentication */\n.login-screen {\n  min-height: 100dvh;\n  padding: 0;\n  display: grid;\n  grid-template-columns: minmax(560px, 53%) minmax(520px, 47%);\n  place-items: stretch;\n  color: var(--ink);\n  background: var(--surface);\n}\n\n.login-visual {\n  position: relative;\n  min-height: 100dvh;\n  overflow: hidden;\n  background: #dce3e0 url(\"/caseflow-service-center.png\") center / cover no-repeat;\n}\n\n.login-visual-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(17, 26, 23, 0.18), rgba(17, 26, 23, 0.5));\n}\n\n.login-brand {\n  position: absolute;\n  z-index: 1;\n  top: 48px;\n  left: 48px;\n  width: auto;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  color: #fff;\n}\n\n.login-brand > span:last-child {\n  display: flex;\n  flex-direction: column;\n}\n\n.login-brand strong {\n  font-size: 18px;\n  line-height: 24px;\n}\n\n.login-brand small {\n  color: rgba(255, 255, 255, 0.78);\n  font-size: 11px;\n}\n\n.brand-mark-light {\n  width: 44px;\n  height: 44px;\n  color: var(--brand-text);\n  background: #fff;\n}\n\n.login-visual-copy {\n  position: absolute;\n  z-index: 1;\n  right: 48px;\n  bottom: 72px;\n  left: 48px;\n  max-width: 620px;\n  color: #fff;\n}\n\n.login-visual-copy .eyebrow {\n  color: rgba(255, 255, 255, 0.86);\n}\n\n.login-visual-copy h1 {\n  margin-top: 16px;\n  font-size: 36px;\n  line-height: 1.12;\n  font-weight: 650;\n}\n\n.login-visual-copy p {\n  max-width: 580px;\n  margin-top: 26px;\n  color: rgba(255, 255, 255, 0.9);\n  font-size: 16px;\n  line-height: 1.55;\n}\n\n.login-form-area {\n  min-width: 0;\n  padding: 48px clamp(48px, 8vw, 160px) 36px;\n  display: grid;\n  grid-template-rows: 1fr auto;\n  align-items: center;\n  background: var(--surface);\n}\n\n.login-panel {\n  width: min(420px, 100%);\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  color: var(--ink);\n  background: transparent;\n  box-shadow: none;\n  justify-self: center;\n}\n\n.login-heading .eyebrow {\n  color: var(--brand-text);\n}\n\n.login-heading h1 {\n  margin: 18px 0 8px;\n  font-size: 28px;\n  line-height: 36px;\n}\n\n.login-heading p {\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.demo-switcher {\n  margin: 34px 0 28px;\n  padding: 4px;\n  border-radius: 0;\n  background: var(--surface-soft);\n}\n\n.demo-switcher button {\n  border-radius: 6px;\n  font-size: 12px;\n}\n\n.demo-switcher button.active {\n  border: 1px solid var(--border);\n  color: var(--brand-text);\n  box-shadow: none;\n}\n\n.login-panel .form-stack {\n  gap: 20px;\n}\n\n.login-panel .field > span:first-child {\n  color: var(--ink);\n  font-size: 13px;\n}\n\n.login-panel .field input,\n.login-panel .password-field {\n  height: 42px;\n}\n\n.login-form-meta {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.remember-field {\n  display: inline-flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--ink);\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.remember-field input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n  accent-color: var(--brand);\n}\n\n.login-button {\n  min-height: 42px;\n  margin-top: 0;\n}\n\n.login-button svg:first-child {\n  margin-right: 2px;\n}\n\n.login-sso {\n  width: 100%;\n  margin-top: 16px;\n}\n\n.login-security {\n  margin-top: 40px;\n  padding-top: 24px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.login-security svg,\n.login-help svg {\n  flex: 0 0 auto;\n  color: var(--brand-text);\n}\n\n.login-security span,\n.login-help span {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.login-security strong,\n.login-help strong {\n  font-size: 12px;\n}\n\n.login-security small,\n.login-help small {\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.login-help {\n  margin-top: 28px;\n  padding: 16px;\n  border-radius: 8px;\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  background: var(--brand-subtle);\n}\n\n.login-footer {\n  width: min(420px, 100%);\n  justify-self: center;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n/* Application shell */\n.app-frame {\n  min-height: 100dvh;\n  background: var(--canvas);\n}\n\n.sidebar {\n  width: 240px;\n  padding: 16px;\n  border-right: 1px solid var(--border);\n  color: var(--ink);\n  background: var(--surface);\n}\n\n.brand {\n  height: 44px;\n  padding: 0;\n}\n\n.brand-link {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.brand-mark {\n  width: 36px;\n  height: 36px;\n  flex: 0 0 36px;\n  border-radius: 8px;\n  color: #fff;\n  background: var(--brand);\n}\n\n.brand-copy {\n  display: flex;\n  flex-direction: column;\n}\n\n.brand-copy strong {\n  color: var(--ink);\n  font-size: 16px;\n  line-height: 22px;\n}\n\n.brand-copy small {\n  color: var(--subtle);\n  font-size: 10px;\n  line-height: 14px;\n}\n\n.main-nav {\n  margin-top: 26px;\n  gap: 8px;\n}\n\n.nav-section-label {\n  margin: 0 0 2px;\n  color: var(--subtle);\n  font-size: 10px;\n  line-height: 14px;\n}\n\n.nav-admin-label {\n  margin-top: 22px;\n}\n\n.nav-item {\n  min-height: 40px;\n  padding: 0 10px;\n  border-radius: 6px;\n  gap: 10px;\n  color: var(--ink);\n  font-size: 14px;\n  font-weight: 450;\n}\n\n.nav-item:hover {\n  color: var(--brand-text);\n  background: var(--surface-soft);\n}\n\n.nav-item.active {\n  color: var(--brand-text);\n  background: var(--selected);\n  font-weight: 650;\n}\n\n.nav-item > span:not(.nav-badge) {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.nav-badge {\n  min-width: 24px;\n  height: 20px;\n  margin-left: auto;\n  padding: 0 6px;\n  border-radius: 10px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--muted);\n  background: var(--surface-muted);\n  font-size: 11px;\n}\n\n.sidebar-footer {\n  gap: 8px;\n}\n\n.organization-switcher {\n  min-height: 64px;\n  padding: 10px;\n  border-color: transparent;\n  grid-template-columns: 36px 1fr 16px;\n  color: var(--ink);\n  background: var(--surface-soft);\n}\n\n.organization-summary {\n  grid-template-columns: 36px minmax(0, 1fr);\n}\n\n.organization-logo {\n  width: 36px;\n  height: 36px;\n  border-radius: 8px;\n  color: var(--brand-text);\n  background: var(--brand-subtle);\n}\n\n.organization-switcher small {\n  color: var(--subtle);\n}\n\n.logout-button {\n  color: var(--muted);\n}\n\n.sidebar-close {\n  color: var(--ink);\n}\n\n.app-main {\n  min-height: 100dvh;\n  margin-left: 240px;\n}\n\n.topbar {\n  height: 64px;\n  padding: 0 24px;\n  background: rgba(255, 255, 255, 0.98);\n}\n\n.topbar-title strong {\n  font-size: 14px;\n  line-height: 20px;\n}\n\n.topbar-title span {\n  color: var(--subtle);\n  font-size: 11px;\n  line-height: 16px;\n}\n\n.global-search {\n  width: 300px;\n  height: 36px;\n  margin-left: auto;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 0 10px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--muted);\n  background: var(--surface-soft);\n}\n\n.global-search:focus-within {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px rgba(20, 107, 87, 0.1);\n}\n\n.global-search input {\n  min-width: 0;\n  flex: 1;\n  border: 0;\n  outline: 0;\n  color: var(--ink);\n  background: transparent;\n  font-size: 12px;\n}\n\n.topbar-actions {\n  margin-left: 12px;\n  gap: 10px;\n}\n\n.notification-button {\n  border-color: transparent;\n}\n\n.notification-dot {\n  background: var(--brand);\n}\n\n.user-summary {\n  min-width: 126px;\n  padding-left: 0;\n  border-left: 0;\n}\n\n.user-summary strong {\n  font-size: 11px;\n}\n\n.user-summary small {\n  color: var(--subtle);\n}\n\n.mobile-brand,\n.mobile-bottom-nav {\n  display: none;\n}\n\n.content {\n  width: 100%;\n  max-width: 1440px;\n  margin: 0 auto;\n  padding: 28px 32px 40px;\n}\n\n.page-stack {\n  gap: 16px;\n}\n\n.page-header {\n  min-height: 64px;\n  align-items: center;\n}\n\n.page-header p,\n.overview-intro p,\n.detail-header p {\n  margin-top: 2px;\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 19px;\n}\n\n/* Overview */\n.operations-overview .metric-grid {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.operations-overview .metric-card {\n  min-height: 132px;\n  padding: 14px 16px;\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 10px;\n}\n\n.metric-card-heading {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.operations-overview .metric-icon {\n  width: 24px;\n  height: 24px;\n  flex-basis: 24px;\n  color: var(--brand-text);\n  background: var(--brand-subtle);\n}\n\n.operations-overview .metric-card > strong {\n  margin: 0;\n  font-size: 28px;\n  line-height: 34px;\n}\n\n.metric-card-footer {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.metric-card-footer small {\n  overflow: hidden;\n  color: var(--subtle);\n  font-size: 11px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.metric-delta {\n  min-width: 52px;\n  height: 20px;\n  padding: 0 6px;\n  border-radius: 10px;\n  display: inline-flex;\n  align-items: center;\n  color: var(--muted);\n  background: var(--surface-muted);\n  font-size: 11px;\n  font-weight: 650;\n}\n\n.metric-delta-up {\n  color: var(--success);\n  background: var(--success-bg);\n}\n\n.metric-delta-down {\n  color: var(--danger);\n  background: var(--danger-bg);\n}\n\n.priority-queue-panel {\n  overflow: hidden;\n}\n\n.priority-queue-panel .panel-heading {\n  padding: 16px 20px;\n}\n\n.priority-queue-panel .panel-heading .eyebrow {\n  margin-bottom: 3px;\n  color: var(--ink);\n  font-size: 18px;\n  line-height: 24px;\n  text-transform: none;\n}\n\n.priority-queue-panel .panel-heading h2 {\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 17px;\n  font-weight: 400;\n}\n\n.priority-table {\n  min-width: 920px;\n}\n\n.priority-table th:nth-child(1) { width: 10%; }\n.priority-table th:nth-child(2) { width: 32%; }\n.priority-table th:nth-child(3) { width: 18%; }\n.priority-table th:nth-child(4) { width: 15%; }\n.priority-table th:nth-child(5) { width: 13%; }\n\n.data-table thead {\n  background: var(--surface-soft);\n}\n\n.data-table th {\n  height: 38px;\n  color: var(--subtle);\n  font-size: 10px;\n  line-height: 14px;\n  text-transform: uppercase;\n}\n\n.data-table td {\n  height: 64px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.data-table td strong,\n.data-table td small {\n  display: block;\n}\n\n.data-table td small {\n  margin-top: 2px;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.selected-row td {\n  background: var(--selected);\n}\n\n.table-footer {\n  min-height: 54px;\n  padding: 0 20px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n/* Requester home */\n.requester-home {\n  width: min(760px, 100%);\n}\n\n.requester-welcome h1 {\n  font-size: 28px;\n}\n\n.requester-welcome p {\n  margin-top: 4px;\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.requester-create {\n  width: 100%;\n}\n\n.requester-ai-card {\n  min-height: 112px;\n  padding: 16px;\n  border: 1px solid var(--ai-border);\n  border-radius: 8px;\n  display: grid;\n  grid-template-columns: 24px 1fr 20px;\n  align-items: center;\n  gap: 12px;\n  color: var(--ai);\n  background: var(--ai-bg);\n}\n\n.requester-ai-card > span {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.requester-ai-card strong {\n  font-size: 14px;\n}\n\n.requester-ai-card small {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.requester-section > header {\n  min-height: 36px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.requester-summary-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.requester-summary-grid article {\n  min-height: 84px;\n  padding: 12px 16px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  background: var(--surface);\n}\n\n.requester-summary-grid strong {\n  font-size: 26px;\n}\n\n.requester-summary-grid span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.requester-summary-grid .requester-summary-warning {\n  border-color: var(--warning-border);\n  color: var(--warning);\n  background: var(--warning-bg);\n}\n\n.requester-summary-warning span {\n  color: var(--warning);\n}\n\n.requester-case-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.requester-case-list > a {\n  min-height: 58px;\n  padding: 8px 12px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  display: grid;\n  grid-template-columns: 1fr auto;\n  grid-template-rows: auto auto;\n  align-items: center;\n  background: var(--surface);\n}\n\n.requester-case-list .case-code {\n  font-size: 11px;\n}\n\n.requester-case-list strong {\n  overflow: hidden;\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.requester-case-list .badge {\n  grid-column: 2;\n  grid-row: 1 / 3;\n}\n\n/* Case queue */\n.filter-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.filter-row {\n  min-height: 40px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.search-box {\n  width: min(500px, 100%);\n  height: 40px;\n  border-color: var(--border);\n  background: var(--surface);\n}\n\n.compact-select {\n  height: 40px;\n  margin-left: 0;\n  border-color: var(--border);\n  background: var(--surface);\n}\n\n.status-tabs {\n  min-height: 44px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: flex-end;\n  gap: 4px;\n  overflow-x: auto;\n}\n\n.status-tabs button {\n  min-width: 118px;\n  height: 40px;\n  border: 0;\n  border-bottom: 2px solid transparent;\n  border-radius: 0;\n  color: var(--muted);\n  background: transparent;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.status-tabs button.active {\n  border-bottom-color: var(--brand);\n  color: var(--brand-text);\n  background: transparent;\n  font-weight: 650;\n}\n\n.table-panel {\n  overflow: hidden;\n}\n\n.table-summary {\n  min-height: 56px;\n  padding: 0 20px;\n}\n\n.cases-table {\n  min-width: 940px;\n}\n\n.cases-table th:nth-child(1) { width: 11%; }\n.cases-table th:nth-child(2) { width: 34%; }\n.cases-table th:nth-child(3) { width: 18%; }\n.cases-table th:nth-child(4) { width: 15%; }\n.cases-table th:nth-child(5) { width: 12%; }\n\n.case-title-cell {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.case-title-cell strong {\n  color: var(--ink);\n}\n\n.case-title-cell small {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n/* Admin master-detail pages */\n.service-admin-layout,\n.user-admin-layout {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(620px, 1fr) 360px;\n  gap: 16px;\n  align-items: start;\n}\n\n.service-catalog-panel,\n.user-list-panel {\n  overflow: hidden;\n}\n\n.service-catalog-panel .panel-heading,\n.user-list-panel .panel-heading {\n  padding: 16px 20px;\n}\n\n.service-list-heading,\n.user-list-heading {\n  min-height: 40px;\n  padding: 0 20px;\n  display: grid;\n  align-items: center;\n  color: var(--subtle);\n  background: var(--surface-soft);\n  font-size: 10px;\n  font-weight: 650;\n  text-transform: uppercase;\n}\n\n.service-list-heading,\n.service-list > button {\n  grid-template-columns: minmax(260px, 1.8fr) minmax(150px, 1fr) 70px 110px;\n}\n\n.service-list,\n.user-list {\n  display: flex;\n  flex-direction: column;\n}\n\n.service-list > button,\n.user-list > button {\n  width: 100%;\n  min-height: 88px;\n  padding: 0 20px;\n  border: 0;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  align-items: center;\n  gap: 12px;\n  color: var(--ink);\n  background: var(--surface);\n  text-align: left;\n  cursor: pointer;\n  content-visibility: auto;\n}\n\n.service-list > button:hover,\n.user-list > button:hover {\n  background: var(--surface-soft);\n}\n\n.service-list > button.selected,\n.user-list > button.selected {\n  background: var(--selected);\n}\n\n.service-list-name {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.service-list-name > span:last-child {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.service-list-name strong {\n  overflow: hidden;\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.service-list-name small {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.service-list-icon {\n  width: 32px;\n  height: 32px;\n  flex: 0 0 32px;\n  border-radius: 6px;\n  display: grid;\n  place-items: center;\n  color: var(--brand-text);\n  background: var(--brand-subtle);\n}\n\n.active-label {\n  min-height: 24px;\n  border: 1px solid var(--success-border);\n  border-radius: 999px;\n  color: var(--success);\n  background: var(--success-bg);\n  font-size: 11px;\n}\n\n.service-config-panel,\n.user-permission-panel {\n  position: sticky;\n  top: 80px;\n  min-height: 620px;\n  padding: 20px;\n}\n\n.service-config-panel > h2 {\n  margin-top: 4px;\n}\n\n.config-key {\n  margin-top: 6px;\n  color: var(--subtle);\n  font-size: 12px;\n}\n\n.config-divider {\n  height: 1px;\n  margin: 20px 0;\n  background: var(--border);\n}\n\n.config-list,\n.permission-meta {\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.config-list > div,\n.permission-meta > div {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  align-items: center;\n  gap: 12px;\n}\n\n.config-list dt,\n.permission-meta dt {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  color: var(--subtle);\n  font-size: 12px;\n}\n\n.config-list dd,\n.permission-meta dd {\n  margin: 0;\n  color: var(--ink);\n  font-size: 13px;\n  font-weight: 650;\n  text-align: right;\n}\n\n.config-section + .config-section {\n  margin-top: 24px;\n}\n\n.config-section h3,\n.permission-section h3 {\n  margin-bottom: 12px;\n}\n\n.config-section p {\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 1.55;\n}\n\n.config-chips {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.config-chips span {\n  padding: 6px 10px;\n  border-radius: 6px;\n  color: var(--brand-text);\n  background: var(--brand-subtle);\n  font-size: 11px;\n  font-weight: 650;\n}\n\n.config-ai-note,\n.permission-note {\n  margin-top: 24px;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  color: var(--success);\n  background: var(--surface-soft);\n}\n\n.config-ai-note span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.config-ai-note strong {\n  font-size: 12px;\n}\n\n.config-ai-note small {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.admin-search {\n  height: 40px;\n  margin: 0 20px 16px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  padding: 0 12px;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  color: var(--muted);\n  background: var(--surface);\n}\n\n.admin-search:focus-within {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 3px rgba(20, 107, 87, 0.1);\n}\n\n.admin-search input {\n  min-width: 0;\n  flex: 1;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  font-size: 13px;\n}\n\n.user-list-heading,\n.user-list > button {\n  grid-template-columns: minmax(250px, 1.5fr) minmax(145px, 0.8fr) minmax(130px, 0.7fr) 104px;\n}\n\n.user-list > button {\n  min-height: 92px;\n}\n\n.member-cell .avatar {\n  width: 44px;\n  height: 44px;\n}\n\n.role-label {\n  width: fit-content;\n  min-height: 28px;\n  padding: 0 9px;\n  border-radius: 6px;\n  color: var(--brand-text);\n  background: var(--brand-subtle);\n  font-size: 11px;\n}\n\n.role-org_admin,\n.role-platform_admin {\n  color: var(--warning);\n  background: var(--warning-bg);\n}\n\n.permission-profile {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.permission-profile > span {\n  min-width: 0;\n}\n\n.permission-profile h2,\n.permission-profile small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.permission-profile small {\n  color: var(--muted);\n}\n\n.permission-section {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.permission-section > div {\n  min-height: 32px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.permission-toggle {\n  width: 36px;\n  height: 20px;\n  flex: 0 0 36px;\n  border-radius: 10px;\n  padding: 2px;\n  display: flex;\n  align-items: center;\n  background: var(--surface-muted);\n}\n\n.permission-toggle > span {\n  width: 16px;\n  height: 16px;\n  border-radius: 50%;\n  background: #fff;\n  box-shadow: 0 1px 2px rgba(17, 26, 23, 0.12);\n}\n\n.permission-section > div.enabled {\n  color: var(--ink);\n}\n\n.permission-section > div.enabled .permission-toggle {\n  justify-content: flex-end;\n  background: var(--brand);\n}\n\n.permission-note {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n/* Existing workflow surfaces */\n.intake-layout,\n.case-detail-grid {\n  gap: 16px;\n}\n\n.intake-form,\n.ai-preview,\n.case-description,\n.action-bar {\n  border-radius: 8px;\n}\n\n.ai-preview,\n.ai-insight-panel {\n  border-color: var(--ai-border);\n}\n\n.ai-label {\n  color: var(--ai);\n  background: var(--ai-bg);\n}\n\n.knowledge-search {\n  border-color: var(--ai-border);\n  background: var(--ai-bg);\n}\n\n.incident-card,\n.service-card {\n  border-radius: 8px;\n  box-shadow: none;\n}\n\n@media (max-width: 1180px) {\n  .service-admin-layout,\n  .user-admin-layout {\n    grid-template-columns: minmax(520px, 1fr) 320px;\n  }\n\n  .service-config-panel,\n  .user-permission-panel {\n    padding: 16px;\n  }\n}\n\n@media (max-width: 980px) {\n  .service-admin-layout,\n  .user-admin-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .service-config-panel,\n  .user-permission-panel {\n    position: static;\n    min-height: 0;\n  }\n}\n\n@media (max-width: 900px) {\n  .sidebar {\n    z-index: 50;\n    width: 280px;\n    box-shadow: 16px 0 40px rgba(17, 26, 23, 0.16);\n  }\n\n  .sidebar-scrim {\n    z-index: 45;\n  }\n\n  .app-main {\n    margin-left: 0;\n  }\n\n  .operations-overview .metric-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 760px) {\n  body {\n    padding-bottom: env(safe-area-inset-bottom);\n  }\n\n  h1 {\n    font-size: 24px;\n    line-height: 31px;\n  }\n\n  .login-screen {\n    min-height: 100dvh;\n    display: block;\n    background: var(--surface);\n  }\n\n  .login-visual {\n    min-height: 236px;\n    height: 236px;\n    background-position: center 46%;\n  }\n\n  .login-brand {\n    top: 20px;\n    left: 20px;\n    gap: 12px;\n  }\n\n  .login-brand .brand-mark-light {\n    width: 36px;\n    height: 36px;\n  }\n\n  .login-brand strong {\n    font-size: 16px;\n  }\n\n  .login-visual-copy {\n    right: 20px;\n    bottom: 14px;\n    left: 20px;\n  }\n\n  .login-visual-copy .eyebrow {\n    display: none;\n  }\n\n  .login-visual-copy h1 {\n    margin: 0;\n    font-size: 23px;\n    line-height: 1.18;\n  }\n\n  .login-visual-copy p {\n    margin-top: 4px;\n    overflow: hidden;\n    font-size: 11px;\n    line-height: 15px;\n    display: -webkit-box;\n    -webkit-box-orient: vertical;\n    -webkit-line-clamp: 2;\n  }\n\n  .login-form-area {\n    padding: 18px 24px 12px;\n    display: block;\n  }\n\n  .login-heading h1 {\n    margin: 8px 0 0;\n    font-size: 25px;\n  }\n\n  .login-heading p {\n    display: none;\n  }\n\n  .demo-switcher {\n    margin: 14px 0 16px;\n  }\n\n  .login-panel .form-stack {\n    gap: 12px;\n  }\n\n  .login-security {\n    display: none;\n  }\n\n  .login-help {\n    margin-top: 18px;\n    padding: 0;\n    display: block;\n    background: transparent;\n  }\n\n  .login-help > svg {\n    display: none;\n  }\n\n  .login-help > span {\n    display: block;\n    color: var(--muted);\n    font-size: 11px;\n    line-height: 16px;\n  }\n\n  .login-help strong,\n  .login-help small {\n    display: inline;\n    color: inherit;\n    font-size: inherit;\n    font-weight: 400;\n  }\n\n  .login-help strong::after {\n    content: \" \";\n  }\n\n  .login-footer {\n    display: block;\n    margin: 20px auto 0;\n  }\n\n  .topbar {\n    height: 64px;\n    padding: 0 16px;\n  }\n\n  .mobile-brand {\n    min-width: 0;\n    border: 0;\n    padding: 0;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    background: transparent;\n    text-align: left;\n    cursor: pointer;\n  }\n\n  .mobile-brand > span:last-child {\n    display: flex;\n    flex-direction: column;\n  }\n\n  .mobile-brand strong {\n    font-size: 16px;\n    line-height: 20px;\n  }\n\n  .mobile-brand small {\n    color: var(--subtle);\n    font-size: 11px;\n    line-height: 16px;\n  }\n\n  .topbar-title,\n  .global-search,\n  .user-summary > span {\n    display: none;\n  }\n\n  .topbar-actions {\n    margin-left: auto;\n  }\n\n  .user-summary {\n    min-width: 36px;\n  }\n\n  .notification-button {\n    width: 36px;\n    height: 36px;\n    flex-basis: 36px;\n  }\n\n  .content {\n    padding: 20px 16px 96px;\n  }\n\n  .mobile-bottom-nav {\n    position: fixed;\n    z-index: 35;\n    right: 0;\n    bottom: 0;\n    left: 0;\n    min-height: calc(72px + env(safe-area-inset-bottom));\n    padding: 7px 8px env(safe-area-inset-bottom);\n    border-top: 1px solid var(--border);\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 2px;\n    background: rgba(255, 255, 255, 0.98);\n    backdrop-filter: blur(12px);\n  }\n\n  .mobile-bottom-nav a {\n    min-width: 0;\n    height: 56px;\n    border-radius: 6px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    color: var(--muted);\n    font-size: 10px;\n  }\n\n  .mobile-bottom-nav a.active {\n    color: var(--brand-text);\n    background: var(--brand-subtle);\n    font-weight: 650;\n  }\n\n  .page-stack {\n    gap: 12px;\n  }\n\n  .page-header,\n  .overview-intro,\n  .detail-header {\n    min-height: auto;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 10px;\n  }\n\n  .page-header .page-actions {\n    display: none;\n  }\n\n  .requester-home {\n    width: 100%;\n    gap: 16px;\n  }\n\n  .requester-welcome h1 {\n    font-size: 25px;\n  }\n\n  .requester-ai-card {\n    min-height: 112px;\n  }\n\n  .requester-summary-grid {\n    gap: 16px;\n  }\n\n  .operations-overview .metric-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 10px;\n  }\n\n  .operations-overview .metric-card {\n    min-height: 116px;\n  }\n\n  .priority-queue-panel .table-scroll {\n    overflow-x: auto;\n  }\n\n  .filter-row {\n    align-items: stretch;\n    flex-direction: row;\n  }\n\n  .search-box {\n    min-width: 0;\n    flex: 1;\n  }\n\n  .compact-select {\n    width: 44px;\n    padding: 0;\n    justify-content: center;\n  }\n\n  .compact-select select {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n  }\n\n  .status-tabs {\n    gap: 8px;\n    border-bottom: 0;\n    align-items: center;\n    scrollbar-width: none;\n  }\n\n  .status-tabs::-webkit-scrollbar {\n    display: none;\n  }\n\n  .status-tabs button {\n    min-width: auto;\n    height: 32px;\n    padding: 0 12px;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: var(--surface);\n    white-space: nowrap;\n  }\n\n  .status-tabs button.active {\n    border-color: var(--selected);\n    background: var(--selected);\n  }\n\n  .table-panel {\n    border: 0;\n    background: transparent;\n  }\n\n  .table-summary {\n    min-height: 44px;\n    padding: 0;\n  }\n\n  .table-summary span {\n    display: none;\n  }\n\n  .cases-table,\n  .cases-table tbody,\n  .cases-table tr,\n  .cases-table td {\n    display: block;\n    width: 100%;\n  }\n\n  .cases-table {\n    min-width: 0;\n  }\n\n  .cases-table thead {\n    display: none;\n  }\n\n  .cases-table tbody {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .cases-table tr {\n    position: relative;\n    min-height: 98px;\n    padding: 12px;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: var(--surface);\n  }\n\n  .cases-table td {\n    height: auto;\n    padding: 0;\n    border: 0;\n  }\n\n  .cases-table td:nth-child(1) {\n    width: auto;\n    margin-bottom: 7px;\n  }\n\n  .cases-table td:nth-child(2) {\n    width: calc(100% - 118px);\n  }\n\n  .cases-table td:nth-child(3) {\n    display: none;\n  }\n\n  .cases-table td:nth-child(4) {\n    position: absolute;\n    right: 12px;\n    bottom: 12px;\n    width: auto;\n  }\n\n  .cases-table td:nth-child(5) {\n    display: none;\n  }\n\n  .cases-table td:nth-child(6) {\n    position: absolute;\n    top: 12px;\n    right: 12px;\n    width: auto;\n    margin: 0;\n    color: var(--subtle);\n    font-size: 11px;\n  }\n\n  .service-admin-layout,\n  .user-admin-layout {\n    display: block;\n  }\n\n  .service-config-panel,\n  .user-permission-panel {\n    display: none;\n  }\n\n  .service-list-heading,\n  .user-list-heading {\n    display: none;\n  }\n\n  .service-list > button,\n  .user-list > button {\n    min-height: 104px;\n    padding: 14px;\n    grid-template-columns: 1fr auto;\n    grid-template-rows: auto auto;\n  }\n\n  .service-list > button > span:nth-child(2),\n  .user-list > button > span:nth-child(3) {\n    color: var(--muted);\n    font-size: 11px;\n  }\n\n  .service-list > button > .active-label,\n  .user-list > button > .active-label {\n    justify-self: end;\n  }\n\n  .admin-search {\n    margin-inline: 14px;\n  }\n\n  .intake-form,\n  .ai-preview,\n  .case-main-column > .panel,\n  .case-side-column > .panel {\n    padding: 16px;\n  }\n\n  .form-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .form-actions {\n    position: static;\n    margin: 0 -16px -16px;\n    padding: 12px 16px;\n    border-top: 1px solid var(--border);\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 8px;\n    background: rgba(255, 255, 255, 0.98);\n  }\n\n  .form-actions .button-secondary {\n    width: 100%;\n    display: inline-flex;\n  }\n\n  .form-actions .button-primary {\n    width: 100%;\n  }\n\n  .case-detail-grid,\n  .intake-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .action-bar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .knowledge-search {\n    padding: 16px;\n  }\n}\n\n@media (max-width: 420px) {\n  .login-help,\n  .login-security {\n    padding-block: 12px;\n  }\n\n  .login-help small,\n  .login-security small {\n    font-size: 10px;\n  }\n\n  .operations-overview .metric-grid {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .operations-overview .metric-card {\n    padding: 12px;\n  }\n}\n\n/* Human-centered visual refresh */\n:root {\n  --ink: #17201d;\n  --muted: #52605b;\n  --subtle: #74817c;\n  --canvas: #f4f6f5;\n  --surface-soft: #f8faf9;\n  --border: #dfe5e2;\n  --border-strong: #cbd5d1;\n  --brand: #176b57;\n  --brand-dark: #115241;\n  --brand-subtle: #eaf5f0;\n  --selected: #dcefe8;\n  --ai: #6b4c78;\n  --ai-bg: #faf7fb;\n  --ai-border: #a98ab5;\n}\n\nbody,\nbutton,\ninput,\ntextarea,\nselect {\n  font-family: \"Open Sans\", \"Segoe UI\", Arial, sans-serif;\n}\n\nh1,\nh2,\nh3,\n.button,\n.nav-item.active {\n  font-weight: 600;\n}\n\n.eyebrow,\n.nav-section-label,\n.data-table th,\n.service-list-heading,\n.user-list-heading {\n  text-transform: none;\n}\n\n.eyebrow,\n.nav-section-label {\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.data-table th,\n.service-list-heading,\n.user-list-heading {\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.page-header h1,\n.detail-header h1,\n.requester-welcome h1 {\n  font-size: 27px;\n  line-height: 1.28;\n}\n\n.panel-heading {\n  border-bottom-color: rgba(203, 213, 209, 0.72);\n}\n\n.locale-switcher {\n  width: fit-content;\n  height: 34px;\n  padding: 3px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  color: var(--muted);\n  background: var(--surface-soft);\n}\n\n.locale-switcher > svg {\n  margin: 0 4px 0 3px;\n}\n\n.locale-switcher button {\n  width: 34px;\n  height: 26px;\n  border: 0;\n  border-radius: 5px;\n  color: var(--muted);\n  background: transparent;\n  font-size: 11px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.locale-switcher button:hover {\n  color: var(--ink);\n  background: #edf1ef;\n}\n\n.locale-switcher button.active {\n  color: var(--brand-dark);\n  background: #fff;\n  box-shadow: 0 1px 3px rgba(23, 32, 29, 0.12);\n}\n\n.locale-switcher-compact {\n  height: 32px;\n  padding: 2px;\n}\n\n.locale-switcher-compact button {\n  width: 30px;\n  height: 26px;\n}\n\n.login-form-area {\n  position: relative;\n}\n\n.login-locale {\n  position: absolute;\n  top: 24px;\n  right: 32px;\n}\n\n.login-visual-overlay {\n  background: rgba(15, 39, 32, 0.43);\n}\n\n.login-visual-copy {\n  padding-left: 18px;\n  border-left: 3px solid rgba(255, 255, 255, 0.78);\n}\n\n.demo-switcher {\n  border: 1px solid var(--border);\n  border-radius: 8px;\n}\n\n/* Metrics read as one operational strip instead of four cloned cards. */\n.operations-overview .metric-grid {\n  gap: 0;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n}\n\n.operations-overview .metric-card {\n  border: 0;\n  border-right: 1px solid var(--border);\n  border-radius: 0;\n  background: transparent;\n}\n\n.operations-overview .metric-card:last-child {\n  border-right: 0;\n}\n\n.operations-overview .metric-card:nth-child(1) {\n  background: #eef7f3;\n}\n\n.operations-overview .metric-card:nth-child(2) .metric-icon {\n  color: #8a5d18;\n  background: #fff3d9;\n}\n\n.operations-overview .metric-card:nth-child(3) .metric-icon {\n  color: #2f6382;\n  background: #e8f3fa;\n}\n\n.operations-overview .metric-card:nth-child(4) .metric-icon {\n  color: #8b4747;\n  background: #faecec;\n}\n\n.priority-queue-panel .panel-heading,\n.service-catalog-panel .panel-heading,\n.user-list-panel .panel-heading {\n  border-bottom: 0;\n}\n\n.requester-ai-card,\n.ai-preview,\n.ai-insight-panel,\n.knowledge-search {\n  border-color: var(--border);\n  border-left: 3px solid var(--ai-border);\n  background: var(--surface);\n}\n\n.requester-ai-card {\n  color: var(--ink);\n}\n\n.knowledge-search {\n  padding: 22px 24px 24px;\n}\n\n.case-description {\n  border-color: var(--border);\n  border-left: 3px solid #7fa6bb;\n}\n\n.config-ai-note,\n.permission-note {\n  border-left: 3px solid #7fb18b;\n  background: #f8fbf8;\n}\n\n.incident-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.incident-card:first-child:nth-last-child(n + 2) {\n  grid-column: 1 / -1;\n  border-left: 3px solid var(--warning-border);\n}\n\n.incident-card:nth-child(3n + 2) .incident-icon {\n  color: #2f6382;\n  background: #e8f3fa;\n}\n\n.incident-card:nth-child(3n + 3) .incident-icon {\n  color: #744f7f;\n  background: #f4ebf7;\n}\n\n.article-list > article,\n.service-list > button,\n.user-list > button {\n  transition: background 150ms ease, border-color 150ms ease;\n}\n\n@media (max-width: 900px) {\n  .operations-overview .metric-card:nth-child(2) {\n    border-right: 0;\n  }\n\n  .operations-overview .metric-card:nth-child(-n + 2) {\n    border-bottom: 1px solid var(--border);\n  }\n\n  .incident-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .incident-card:first-child:nth-last-child(n + 2) {\n    grid-column: auto;\n  }\n}\n\n@media (max-width: 760px) {\n  .login-form-area {\n    padding-top: 58px;\n  }\n\n  .login-locale {\n    top: 14px;\n    right: 20px;\n  }\n\n  .login-visual-copy {\n    padding-left: 12px;\n  }\n\n  .notification-button {\n    display: none;\n  }\n\n  .topbar-actions {\n    gap: 8px;\n  }\n\n  .operations-overview .metric-grid {\n    gap: 0;\n  }\n}\n\n/* Operational completion: notifications, review state, and attachments */\n.notification-center {\n  position: relative;\n}\n\n.notification-count {\n  position: absolute;\n  top: -5px;\n  right: -6px;\n  min-width: 17px;\n  height: 17px;\n  padding: 0 4px;\n  border: 2px solid #fff;\n  border-radius: 9px;\n  display: grid;\n  place-items: center;\n  color: #fff;\n  background: var(--red);\n  font-size: 8px;\n  font-weight: 800;\n}\n\n.notification-popover {\n  position: absolute;\n  z-index: 80;\n  top: calc(100% + 10px);\n  right: 0;\n  width: min(360px, calc(100vw - 24px));\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: #fff;\n  box-shadow: 0 16px 40px rgba(24, 38, 33, 0.16);\n}\n\n.notification-popover > header {\n  min-height: 58px;\n  padding: 10px 12px 10px 15px;\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.notification-popover > header > div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.notification-popover > header strong {\n  font-size: 13px;\n}\n\n.notification-popover > header span,\n.notification-item time {\n  color: var(--muted);\n  font-size: 9px;\n}\n\n.notification-list {\n  max-height: 390px;\n  overflow-y: auto;\n}\n\n.notification-item {\n  width: 100%;\n  min-height: 74px;\n  padding: 11px 14px;\n  border: 0;\n  border-bottom: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 7px minmax(0, 1fr);\n  gap: 9px;\n  text-align: left;\n  background: #fff;\n}\n\n.notification-item:hover,\n.notification-item.unread {\n  background: #f5faf8;\n}\n\n.notification-item-marker {\n  width: 7px;\n  height: 7px;\n  margin-top: 5px;\n  border-radius: 50%;\n  background: transparent;\n}\n\n.notification-item.unread .notification-item-marker {\n  background: var(--brand);\n}\n\n.notification-item > span:last-child {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.notification-item strong,\n.notification-item small {\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.notification-item strong {\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.notification-item small {\n  color: var(--muted);\n  font-size: 10px;\n  line-height: 1.4;\n}\n\n.notification-empty {\n  min-height: 96px;\n  padding: 18px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: var(--muted);\n  font-size: 11px;\n  text-align: center;\n}\n\n.action-bar {\n  flex-wrap: wrap;\n}\n\n.analysis-review-note {\n  padding: 11px 12px;\n  border: 1px solid #ead7a4;\n  border-radius: 6px;\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  color: #6f571b;\n  background: #fffaf0;\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.attachment-list {\n  border-bottom: 1px solid var(--border);\n}\n\n.attachment-list article {\n  min-height: 58px;\n  padding: 9px 16px;\n  border-top: 1px solid var(--border);\n  display: grid;\n  grid-template-columns: 32px minmax(0, 1fr) 34px;\n  align-items: center;\n  gap: 10px;\n}\n\n.attachment-file-icon {\n  width: 30px;\n  height: 30px;\n  border-radius: 6px;\n  display: grid;\n  place-items: center;\n  color: var(--brand);\n  background: #e7f2ee;\n}\n\n.attachment-list article > div {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.attachment-list strong {\n  overflow: hidden;\n  font-size: 11px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.attachment-list article > div > span {\n  color: var(--muted);\n  font-size: 9px;\n}\n\n.attachment-upload {\n  padding: 14px 16px;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 10px;\n}\n\n.attachment-upload .file-upload-area {\n  width: 100%;\n}\n\n.attachment-panel > .form-error {\n  margin: 0 16px 14px;\n}\n\n.ai-review-row {\n  min-height: 58px;\n  padding: 10px 18px;\n  border-top: 1px solid var(--border);\n  display: flex;\n  align-items: flex-start;\n  gap: 9px;\n  color: var(--brand);\n  background: #f7fbf9;\n}\n\n.ai-review-row > div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.ai-review-row strong {\n  font-size: 10px;\n}\n\n.ai-review-row span {\n  color: var(--muted);\n  font-size: 9px;\n  line-height: 1.4;\n}\n\n.ai-review-pending {\n  color: #8a681b;\n  background: #fffaf0;\n}\n\n.ai-review-corrected {\n  color: #704e7a;\n  background: #faf7fb;\n}\n\n@media (max-width: 760px) {\n  .notification-button {\n    display: grid;\n  }\n\n  .notification-popover {\n    position: fixed;\n    top: 58px;\n    right: 12px;\n    left: 12px;\n    width: auto;\n  }\n\n  .attachment-upload {\n    align-items: stretch;\n  }\n\n  .attachment-upload > .button {\n    width: 100%;\n  }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"boot-screen"},["DIV",{"class":"state-panel"},["SPAN",{"class":"spinner"}],["SPAN",{},"Đang tải không gian làm việc"]]]],"\n    ","\n  \n\n"]],"viewport":{"width":1440,"height":1000},"timestamp":5869.989,"wallTime":1787999674073,"collectionTime":2.600000023841858,"resourceOverrides":[],"isMainFrame":true}}

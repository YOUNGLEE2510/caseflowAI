PORT=4000
# Optional external drafting. Disabled until key, model and organization allowlist are set.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_ALLOWED_ORGANIZATIONS=
API_RATE_LIMIT_PER_MINUTE=100
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=caseflow_ai
JWT_SECRET=replace-with-a-long-random-secret
WEB_ORIGIN=http://localhost:5173
AI_SERVICE_URL=http://127.0.0.1:8001
AUTO_SEED=false
LOG_LEVEL=dev
# Optional email delivery. Leave unset to keep email disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

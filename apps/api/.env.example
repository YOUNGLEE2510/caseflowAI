PORT=4000
# Optional external drafting. Disabled until key, model and organization allowlist are set.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_ALLOWED_ORGANIZATIONS=
API_RATE_LIMIT_PER_MINUTE=100
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=caseflow_ai
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
# Docker enables S3 and ClamAV; these defaults are for legacy local development.
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=caseflow-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
MALWARE_SCAN_MODE=disabled
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=20000
WEB_ORIGIN=http://localhost:5173
# Optional Google sign-in. Create a Web application OAuth client in Google Cloud.
# The redirect URI must match this API endpoint exactly.
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback
MICROSOFT_OAUTH_TENANT=common
TRUST_PROXY_HOPS=0
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
AI_SERVICE_URL=http://127.0.0.1:8001
AI_REQUEST_TIMEOUT_MS=10000
AI_INTERNAL_TOKEN=
DEPLOYMENT_MODE=local
AUDIT_RETENTION_DAYS=365
AI_FALLBACK_KEYWORDS=
SLA_CHECK_INTERVAL_MINUTES=15
SLA_CHECK_ON_START=true
AUTO_SEED=false
LOG_LEVEL=dev
# Optional SMTP email delivery. Gmail requires a 16-character App Password, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
